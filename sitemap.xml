<?xml version="1.0" encoding="UTF-8"?>
<!-- 两个语言版本互相声明 hreflang，和页面 <head> 里的 alternate 一致。
     故意不写 <lastmod>：Google 只在 lastmod 长期准确时才采信，
     与其写一个会过期的日期，不如不写。 -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://www.tqdropshipping.com/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.tqdropshipping.com/"/>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://www.tqdropshipping.com/zh/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.tqdropshipping.com/"/>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.tqdropshipping.com/zh/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="https://www.tqdropshipping.com/"/>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://www.tqdropshipping.com/zh/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://www.tqdropshipping.com/"/>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
